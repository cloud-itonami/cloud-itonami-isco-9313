;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a material-handling and site-prep robot
;; performs debris clearing, material staging and site-marking for building
;; construction labourers (ISCO 9313). Its physical work: hauling construction
;; debris across the rough site to the skip, and staging concrete blocks from
;; the delivery pallet to the bricklayer's work station.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-9313"
 :cases
 [{:id :debris-to-skip
   :kind :transport
   :procedure "tracked carrier hauls a load of construction debris 50 m over the rough site to the skip"
   :params {:mass-kg 200.0 :payload-kg 200.0 :distance-m 50.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 700.0 :crr 0.10
            :cog-height-m 0.40 :support-half-length-m 0.45 :payload-cog-height-m 0.60
            :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [100.0 200.0 300.0 400.0 500.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: one debris run per crew clean-up interval so work areas stay clear"}
   :boundary {:lo 0.0 :hi 600.0}}
  {:id :block-staging
   :kind :manipulator
   :procedure "arm picks a concrete block from the delivery pallet and sets it on the bricklayer's staging stand"
   :params {:l1-m 0.65 :l2-m 0.55 :m1-kg 9.0 :m2-kg 6.0
            :from [0.70 0.00] :to [0.30 0.85] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [8.0 12.0 16.0 20.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 280.0 :basis "estimate: continuous shoulder torque of a ~25 kg-payload handling arm"}
   :boundary {:lo 1.0 :hi 60.0}}]}
